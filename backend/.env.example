# Backend local environment template.
# Copy to `backend/.env` (or the repository root `.env`) and adjust as needed.
# NEVER commit real secrets. Values here are development defaults only.

# Application
APP_NAME=ColdChain AI API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server
# HOST=0.0.0.0
# PORT=8000

# Security (replace in production)
SECRET_KEY=dev-only-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database - matches docker-compose defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=coldchain
POSTGRES_PASSWORD=coldchain
POSTGRES_DB=coldchain

# DATABASE_URL=postgresql+psycopg://coldchain:coldchain@localhost:5432/coldchain

# CORS - comma separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenWeather - leave WEATHER_API_KEY empty for deterministic mock mode
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
WEATHER_API_KEY=
WEATHER_UNITS=metric
WEATHER_CACHE_TTL_MINUTES=30
WEATHER_HTTP_TIMEOUT_SECONDS=10.0
WEATHER_RETRY_ATTEMPTS=3
WEATHER_RETRY_BACKOFF_SECONDS=1.0
WEATHER_BACKGROUND_REFRESH_INTERVAL_MINUTES=30
