# Frontend git ignore.
# See root .gitignore for repo-wide patterns.

# dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel